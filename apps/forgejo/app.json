{
  "id": "forgejo",
  "name": "Forgejo",
  "category": "dev",
  "channel": "stable",
  "repository": "official",
  "capabilities": {
    "reverse_proxy": true,
    "gpu": false,
    "docker_socket": false,
    "privileged": false
  },
  "network": {
    "public": true,
    "internal": true
  },
  "ports": [
    {
      "name": "web",
      "container": 3000,
      "dynamic": true
    },
    {
      "name": "ssh",
      "container": 2223,
      "host": 2223,
      "dynamic": false,
      "firewall": true,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "source": "app-data/forgejo/data",
      "target": "/data"
    },
    {
      "source": "app-data/forgejo/db",
      "target": "/var/lib/postgresql/data"
    }
  ],
  "backup": {
    "enabled": true
  },
  "secure_headers": true,
  "description": "Forge Git auto-hébergée (fork communautaire de Gitea), légère et complète. SSO Authentik natif."
}