#!/usr/bin/env bash
set -x

source /var/lib/wazo/helpers

# Allow wazo-confd to write file 05-autoprov-wizard.conf
chown asterisk:www-data /etc/asterisk/pjsip.d
chmod 770 /etc/asterisk/pjsip.d

# Allow wazo-calld to write file
chown asterisk:www-data /var/spool/asterisk/voicemail
chmod 770 /var/spool/asterisk/voicemail

db_host='postgres'
db_port='5432'

echo Waiting for postgres...
wait_for_service $db_host $db_port

confd_host='confd'
confd_port='9486'

echo Waiting for asterisk DB initialized...
wait_for_service $confd_host $confd_port

confgend_host='confgend'
confgend_port='8669'

echo Waiting for wazo-confgend...
wait_for_service $confgend_host $confgend_port

wazo-confgen asterisk/modules.conf > /etc/asterisk/modules.conf

# --- Caleope: réconciliation confd -> asterisk (PJSIP + dialplan) ----------
# Le harness wazo-docker ne câble pas le reload automatique (sysconfd est dans
# un conteneur séparé du filesystem d'asterisk). Sans ça, provisionner un
# utilisateur/une ligne via l'UI web ne pousse RIEN vers asterisk : aucun
# téléphone ne peut s'enregistrer (PJSIP) ni s'appeler (dialplan).
# On génère donc la config depuis confd au boot puis on reconcilie en continu :
# on régénère et on recharge QUAND la config change (comparaison, pas de reload
# inutile).
CALEOPE_PJSIP=/etc/asterisk/pjsip.conf
CALEOPE_DIALPLAN=/etc/asterisk/extensions.d/50-caleope-users.conf

caleope_gen_pjsip() {
    # Sortie = config PJSIP complète depuis confd (global/system/transports/
    # endpoints/auths/aors). On N'inclut PAS pjsip.d/*.conf : le fichier
    # d'autoprovisioning (05-autoprov-wizard.conf) redéfinit [global](+) et
    # entre en conflit avec le [global] émis par confgen -> res_pjsip rejette
    # alors TOUT le fichier ("duplicate object 'global'") et ne charge aucun
    # endpoint. L'autoprov concerne le provisioning de téléphones physiques
    # (DHCP/TFTP), hors périmètre softphone. On garde donc la sortie confgen
    # pure, qui charge correctement les comptes SIP.
    # Garde-fou : ne considérer la génération valide que si la sortie contient
    # bien les transports (sinon confd transitoirement indisponible -> on ne
    # veut pas écraser une bonne config par une config dégradée).
    if wazo-confgen asterisk/pjsip.conf > /tmp/pjsip.caleope 2>/dev/null \
       && grep -q 'type = transport' /tmp/pjsip.caleope; then
        return 0
    fi
    return 1
}

caleope_gen_dialplan() {
    # Contextes utilisateurs + motifs d'extensions (ex: 1001 -> PJSIP/<endpoint>)
    # depuis confd. Écrit dans un fichier séparé de extensions.d/ (chargé via
    # #include extensions.d/*.conf) : les contextes se MERGENT avec la base
    # wazo (extensions_lib_*.conf, contextes helper user/contextlib/paging...)
    # sans conflit. Garde-fou : présence du contexte des fonctionnalités wazo.
    if wazo-confgen asterisk/extensions.conf > /tmp/extensions.caleope 2>/dev/null \
       && grep -q '^\[xivo-features\]' /tmp/extensions.caleope; then
        return 0
    fi
    return 1
}

# Génération initiale (asterisk pas encore démarré : on écrit juste les fichiers)
caleope_gen_pjsip    && cp /tmp/pjsip.caleope      "$CALEOPE_PJSIP"
caleope_gen_dialplan && cp /tmp/extensions.caleope "$CALEOPE_DIALPLAN"

# Boucle de réconciliation en tâche de fond
(
    # Attendre qu'asterisk réponde à la CLI
    until asterisk -rx 'core show version' >/dev/null 2>&1; do sleep 3; done
    echo '[caleope-reconcile] asterisk prêt, réconciliation PJSIP + dialplan active (15s)'
    while true; do
        if caleope_gen_pjsip && ! cmp -s /tmp/pjsip.caleope "$CALEOPE_PJSIP"; then
            cp /tmp/pjsip.caleope "$CALEOPE_PJSIP"
            asterisk -rx 'module reload res_pjsip.so' >/dev/null 2>&1
            echo '[caleope-reconcile] pjsip.conf régénéré + res_pjsip rechargé'
        fi
        if caleope_gen_dialplan && ! cmp -s /tmp/extensions.caleope "$CALEOPE_DIALPLAN"; then
            cp /tmp/extensions.caleope "$CALEOPE_DIALPLAN"
            asterisk -rx 'dialplan reload' >/dev/null 2>&1
            echo '[caleope-reconcile] dialplan régénéré + rechargé'
        fi
        sleep 15
    done
) &
# --------------------------------------------------------------------------

exec "$@"
